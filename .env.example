# Local development only. Copy to .env; never use these credentials publicly.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
MINI_APP_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DEPENDENCY_TIMEOUT_MS=2000
WORKER_CONCURRENCY=2
POSTGRES_USER=openfacto
POSTGRES_PASSWORD=local-openfacto-password
POSTGRES_DB=openfacto
DATABASE_URL=postgresql://openfacto:local-openfacto-password@127.0.0.1:5432/openfacto
RABBITMQ_DEFAULT_USER=openfacto
RABBITMQ_DEFAULT_PASS=local-openfacto-password
OPENFACTO_RABBITMQ_PORT=5672
OPENFACTO_RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://openfacto:local-openfacto-password@127.0.0.1:5672/%2f
QDRANT_URL=http://127.0.0.1:6333
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=openfacto-private
S3_ACCESS_KEY_ID=local-openfacto
S3_SECRET_ACCESS_KEY=local-openfacto-secret

# Server only. WikiVibe DeepSeek model; prices below are local estimates in millionths of USD.
AI_CHAT_ENDPOINT=https://api.wikivibe.dev/v1/chat/completions
AI_CHAT_MODEL=deepseek-v4.1-flash
# Optional independent checker on the same endpoint/key; empty uses AI_CHAT_MODEL.
AI_VERIFY_MODEL=
# Empty: provider default. Only set a reasoning_effort supported by the configured provider/model.
AI_REASONING_EFFORT=
# DeepSeek: disabled for a fast non-thinking comparison; empty leaves other APIs unchanged.
AI_THINKING_MODE=disabled
# Opt in to compact instructions only after quality/cost evaluation; 0 keeps the original policy.
AI_COMPACT_OUTPUT=0
# 1: interpret and select together, then independently verify; 0: legacy three-stage comparison.
AI_COMBINED_PLANNING=1
# Cache only verified published answers for 60s; invalidate on any published knowledge change.
AI_RESPONSE_CACHE=1
# Wake committed questions and ready deliveries immediately; 0 keeps periodic recovery only.
AI_IMMEDIATE_DISPATCH=1
AI_PLATFORM_KEY=
# Conservative example rates only. Verify the applicable WikiVibe key tariff before paid calls.
AI_INPUT_MICROS_PER_1K=300
AI_OUTPUT_MICROS_PER_1K=1200
AI_PLATFORM_DAILY_MICROS=1000000
MANAGER_BOT_TOKEN=
MINI_APP_PUBLIC_URL=
PUBLIC_WEBHOOK_ORIGIN=
TELEGRAM_DAILY_CHAT_LIMIT=100
BOT_ENCRYPTION_KEY=
PDF_WORKER_TOKEN=
PDF_WORKER_URL=http://127.0.0.1:8001

# Local inference. Configure after running apps/semantic-worker/benchmark.py.
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_REVISION=
EMBEDDING_DIMENSIONS=384
LOCAL_EMBEDDING_PROFILE=e5
# Keep disabled unless it improves held-out RU/KK retrieval.
RERANK_URL=
