{
  "name": "openfacto",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "dev": "TURBO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 turbo run dev",
    "build": "TURBO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 turbo run build",
    "lint": "TURBO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 turbo run lint",
    "typecheck": "TURBO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 turbo run typecheck",
    "test": "TURBO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 turbo run test",
    "test:integration": "TURBO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 turbo run test:integration",
    "test:e2e": "TURBO_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 turbo run test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @openfacto/database db:generate",
    "db:migrate": "pnpm --filter @openfacto/database db:migrate",
    "python:sync": "uv sync --locked --project apps/pdf-worker",
    "python:lint": "uvx ruff==0.14.3 check apps/pdf-worker",
    "python:test": "uv run --locked --directory apps/pdf-worker python -m unittest discover -s tests",
    "python:smoke": "uv run --locked --directory apps/pdf-worker python -m openfacto_pdf --check",
    "verify:local": "node --env-file-if-exists=.env scripts/verify-local.mjs",
    "check:spa": "node scripts/check-spa.mjs",
    "python:test:integration": "uv run --locked --directory apps/pdf-worker python -m unittest discover -s integration",
    "db:verify:sql": "python3 scripts/verify-sql-offline.py"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "@types/node": "24.19.2",
    "vitest": "4.1.12",
    "oxlint": "1.91.0",
    "@aws-sdk/client-s3": "3.1163.0"
  },
  "engines": {
    "node": ">=24 <27",
    "pnpm": "12.17.0"
  },
  "type": "module"
}
